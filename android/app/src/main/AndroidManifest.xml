<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required on Android 13+ to show notifications (push and local). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Required by speech_to_text for voice commands. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- UI was designed and verified only against phone-sized screens —
         opting out of large/xlarge (7"/10" tablet) screens rather than
         shipping an unadapted, oversized-looking layout on them. Also
         exclude tablet form factors in Play Console's Device Catalog
         (App content), since Play primarily filters by that now, not
         this legacy tag. -->
    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="false"
        android:xlargeScreens="false"
        android:anyDensity="true" />
    <!-- Requiring a touchscreen is what actually excludes Android TV
         (remote-controlled, reports no touchscreen) and Android
         Automotive/Auto head units from the Play Store listing — this is
         a real capability requirement (the whole UI is tap-driven), not
         just a targeting hint like <supports-screens> above. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <application
        android:label="mycove"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Matches the channel id created in lib/core/push/push_service.dart -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="high_importance_channel" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required by share_plus so the native share sheet can discover
             other apps (WhatsApp, Telegram, etc.) on Android 11+ (API 30+). -->
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required by speech_to_text on Android 11+ (API 30+) so the
             on-device speech recognition service is visible to the app. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
